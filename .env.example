# Server-only. Set these in Vercel (Project Settings > Environment Variables) and, for
# local dev, in .env.local (git-ignored). None of them ever reaches the browser.

# Claude API key for the assistant (api/copilot.ts).
ANTHROPIC_API_KEY=

# Upstash Redis REST credentials: rate limits, suggested-question cache, question log.
# The Vercel Upstash integration may name them KV_REST_API_URL / KV_REST_API_TOKEN;
# either pair works. Not needed locally (limits fall back to memory off Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string that salts the IP hash used as the rate-limit key.
IP_HASH_SALT=

# Optional overrides.
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_THINKING=off
# ASSISTANT_PER_IP_HOURLY=10
# ASSISTANT_DAILY_CAP=300
