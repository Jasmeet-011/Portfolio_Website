# Server-only. Set these in Vercel (Project Settings > Environment Variables) and, for
# local dev, in .env.local (git-ignored). None of them ever reaches the browser.
#
# Variable                  Vercel    Local     What it is
# GEMINI_API_KEY            required  required  Gemini API key, from the site's own Google Cloud project
# GEMINI_EVAL_API_KEY       never     for eval  Key from a separate project, so evals don't spend the site's quota
# ASSISTANT_PROVIDER        optional  optional  gemini (default) or anthropic
# ANTHROPIC_API_KEY         if anthropic        Claude API key
# UPSTASH_REDIS_REST_URL    required  no        Upstash Redis: limits, answer cache, question log
# UPSTASH_REDIS_REST_TOKEN  required  no        (or KV_REST_API_URL / KV_REST_API_TOKEN from the integration)
# IP_HASH_SALT              required  no        Long random string salting the rate-limit IP hash
# ASSISTANT_DAILY_CAP       optional  optional  Defaults to 80% of the free-tier RPD (400 for Gemini)
# ASSISTANT_PER_MINUTE      optional  optional  Defaults to 80% of the free-tier RPM (12 for Gemini)
#
# On Vercel the assistant fails closed (503) without the key, Upstash, the salt, or a
# known daily cap and per-minute limit (from `freeTier` in api/_lib/provider/index.ts,
# or the two variables above).

# Gemini API key for the assistant (api/copilot.ts).
GEMINI_API_KEY=

# Eval only (npm run eval:assistant): a key from a different Google Cloud project, so
# eval runs never use the site's free quota. Falls back to GEMINI_API_KEY when unset.
GEMINI_EVAL_API_KEY=

# Upstash Redis REST credentials: rate limits, suggested-question cache, question log,
# and the "daily quota used up" latch. The Vercel Upstash integration may name them
# KV_REST_API_URL / KV_REST_API_TOKEN; either pair works. Not needed locally (limits
# fall back to memory off Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string that salts the IP hash used as the rate-limit key.
IP_HASH_SALT=

# Optional overrides.
# ASSISTANT_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=gemini-3.5-flash-lite
# ASSISTANT_THINKING=minimal
# ASSISTANT_PER_IP_HOURLY=10
# Default to about 80% of the model's free-tier RPD and RPM (Decisions log): 400 and 12
# for gemini-3.5-flash-lite. Set them only to go lower.
# ASSISTANT_DAILY_CAP=
# ASSISTANT_PER_MINUTE=
# Eval pacing, requests a minute (default 80% of the free-tier RPM: 12 for Gemini).
# ASSISTANT_EVAL_RPM=
